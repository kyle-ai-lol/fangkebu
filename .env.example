# 房客簿的環境變數。複製成 .env.local 再填值；.env.local 不會進 git。
# 本機開發不用自己填：npm run db:start 產生的本機網址和測試金鑰已經寫在 .env.local。
# 下面的申請位置是正式環境（Supabase 雲端專案）用的。

# Supabase 專案網址：Supabase 後台，專案頁右上角的「Connect」
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key（sb_publishable_ 開頭，可以放在瀏覽器）：Supabase 後台 → Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key（sb_secret_ 開頭，只能放伺服器，外流等於資料庫被打開）：Supabase 後台 → Settings → API Keys
SUPABASE_SECRET_KEY=

# ----- 階段 2 以後才用得到（到時候會再確認申請位置） -----
# Anthropic API 金鑰：Anthropic Console 的 API Keys 頁
ANTHROPIC_API_KEY=
# AI 模型，預設 claude-haiku-4-5-20251001，要換模型改這裡
AI_MODEL=claude-haiku-4-5-20251001
# 加密 LINE channel secret、access token 用的金鑰（階段 3 會附產生方式）
ENCRYPTION_KEY=
